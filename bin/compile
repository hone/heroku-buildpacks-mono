#!/usr/bin/env bash

set -e
set -o pipefail

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

NU_VERSION="0.102.0"
NU_DIR="$CACHE_DIR/nushell"
NU_BIN="$NU_DIR/nu"

if [ ! -f "$NU_BIN" ]; then
  echo "-----> Installing Nushell v$NU_VERSION..."
  mkdir -p "$NU_DIR"
  URL="https://github.com/nushell/nushell/releases/download/$NU_VERSION/nu-$NU_VERSION-x86_64-unknown-linux-musl.tar.gz"
  curl -sL "$URL" | tar xz -C "$NU_DIR" --strip-components=1
fi

export PATH="$NU_DIR:$PATH"

BP_DIR=$(cd $(dirname $0)/..; pwd)
echo "-----> Handing off to orchestrator.nu"
exec nu "$BP_DIR/orchestrator.nu" "$BUILD_DIR" "$CACHE_DIR" "$ENV_DIR"
